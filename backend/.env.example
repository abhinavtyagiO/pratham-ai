# Commands run from backend/. SQLite is available for credential-free development.
DATABASE_URL=sqlite:///./pa.db
# For Docker PostgreSQL instead:
# DATABASE_URL=postgresql+psycopg://pa:pa_local@localhost:5432/pa
PROVIDER_MODE=mock
LOG_LEVEL=INFO
# Optional standard OpenTelemetry HTTP exporter, e.g. http://localhost:4318
# OTEL_EXPORTER_OTLP_ENDPOINT=
