# Commands run from backend/. SQLite is available for credential-free development.
DATABASE_URL=sqlite:///./pa.db
# For Docker PostgreSQL instead:
# DATABASE_URL=postgresql+psycopg://pa:pa_local@localhost:5432/pa
PROVIDER_MODE=mock
LOG_LEVEL=INFO
# Required for HTTP data endpoints; set a long random value in .env, never in Git.
API_KEY=
# Voice ingress is disabled until explicitly configured. Slice 2A uses audible tone mocks.
VOICE_ENABLED=false
VOICE_MODE=mock
VOICE_BUSINESS_ID=00000000-0000-0000-0000-000000000001
VOICE_EXOTEL_WS_USER=pratham
VOICE_EXOTEL_WS_PASSWORD=
VOICE_EXOTEL_ACCOUNT_SID=
VOICE_EXOTEL_TO_NUMBER=
VOICE_VAD_MODE=energy
VOICE_MIN_SPEECH_MS=100
VOICE_SILENCE_MS=700
VOICE_ENERGY_RMS=500
# Optional standard OpenTelemetry HTTP exporter, e.g. http://localhost:4318
# OTEL_EXPORTER_OTLP_ENDPOINT=
